{
  "expo": {
    "name": "KRIBB",
    "slug": "kribb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kribb-icon.png",
    "scheme": "kribb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kribb.app",
      "icon": "./assets/images/kribb-icon.png"
    },
    "android": {
      "package": "com.kribb.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/kribb-adaptive-icon.png",
        "monochromeImage": "./assets/images/kribb-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kribb-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/kribb-splash.png",
          "imageWidth": 280
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyD8Sq8YAugBFw3Zth1UloYLi1jVjeoWwrg"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80935a1a-55d0-4343-921a-b130de397d16"
      }
    }
  }
}