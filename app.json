{
  "expo": {
    "name": "KRIBB",
    "slug": "KRIBB",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kribb-icon.png",
    "scheme": "kribb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kribb-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/kribb-monochrome.png",
        "monochromeImage": "./assets/images/kribb-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kribb-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/kribb-splash.png",
          "imageWidth": 280
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}